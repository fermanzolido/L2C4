<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Levanta MariaDB, Apache, login server y game server en orden al iniciar sesion. Script y explicacion en tools/start-all.ps1 del repo l2c4.</Description>
    <URI>\L2C4 Autostart</URI>
  </RegistrationInfo>
  <Triggers>
    <!-- Un minuto de margen: la red y el cliente de No-IP tienen que estar
         arriba antes de que el login intente resolver nada. Sin repeticion:
         esto corre una vez por inicio de sesion, no en bucle. -->
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>Man_z</UserId>
      <Delay>PT1M</Delay>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>Man_z</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <!-- El peor caso de la cadena son 330s de esperas. PT10M deja aire. -->
    <ExecutionTimeLimit>PT10M</ExecutionTimeLimit>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File "C:\Users\Man_z\Desktop\servidor\l2c4\tools\start-all.ps1"</Arguments>
    </Exec>
  </Actions>
</Task>
